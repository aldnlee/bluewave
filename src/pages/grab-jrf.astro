---
import { getSupabase } from '../lib/supabase';
import '../styles/global.css';

let message = '';
let isSuccess = false;

const locals = Astro.locals as any;
const runtimeEnv = locals?.runtime?.env || locals?.cloudflare?.env;
const supabase = getSupabase(runtimeEnv);

// ID Sesi Campaign Grab Road to JRF
const CAMPAIGN_SESSION_ID = '66666666-6666-4666-a666-666666666666';

let sessionDetails: { title: string; session_date: string } | null = null;

// Tangkap Submit Form Registrasi
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();

    const fullName = formData.get('full_name')?.toString()?.trim();
    const phoneNumber = formData.get('phone_number')?.toString()?.trim();
    const email = formData.get('email')?.toString()?.trim();
    const tier = 'bluewave';

    if (fullName && phoneNumber && email) {
      const { data, error } = await supabase.rpc('register_bluewave_session', {
        p_session_id: CAMPAIGN_SESSION_ID,
        p_full_name: fullName,
        p_phone_number: phoneNumber,
        p_tier: tier,
        p_email: email,
      });

      if (error) {
        message = `Gagal memproses pendaftaran: ${error.message}`;
      } else if (data && !data.success) {
        message = data.message;
      } else if (data && data.success) {
        message = data.message || 'Pendaftaran Grab Road to JRF Berhasil!';
        isSuccess = true;
      }
    } else {
      message = 'Harap isi semua kolom wajib!';
    }
  } catch (err: any) {
    message = `Terjadi kesalahan sistem: ${err.message}`;
  }
}

// Fetch Jadwal Sesi (Hanya ambil title dan tanggal)
try {
  const { data: sessionData } = await supabase
    .from('sessions')
    .select('title, session_date')
    .eq('id', CAMPAIGN_SESSION_ID)
    .single();

  if (sessionData) sessionDetails = sessionData;
} catch (e: any) {
  console.error('Fetch error:', e.message);
}
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Grab Road to Jakarta Running Festival - Registration</title>
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4 font-sans">
    <div class="max-w-lg w-full bg-slate-800/95 backdrop-blur-md p-6 sm:p-8 rounded-2xl shadow-2xl border border-emerald-500/30">
      
      <!-- Brand & Event Badge -->
      <div class="text-center mb-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 mb-3">
          <span>Official Road to Campaign</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          GRAB <span class="text-emerald-400">ROAD TO JRF</span>
        </h1>
        <p class="text-xs text-slate-400 mt-1">Jakarta Running Festival Special Community Training</p>
        
        <!-- Info Jadwal (Tanpa Kuota) -->
        {sessionDetails && (
          <div class="mt-4 p-3.5 bg-slate-700/50 border border-slate-600 rounded-xl text-center text-xs">
            <span class="text-slate-400">Jadwal Sesi Latihan: </span>
            <strong class="text-emerald-400 font-semibold">{sessionDetails.session_date}</strong>
          </div>
        )}
      </div>

      <!-- Alert Notifikasi -->
      {message && (
        <div class={`p-4 rounded-xl mb-6 text-sm font-medium border ${
          isSuccess 
            ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' 
            : 'bg-rose-500/10 text-rose-400 border-rose-500/30'
        }`}>
          {message}
        </div>
      )}

      <!-- Form Submission -->
      <form method="POST" id="campaignForm" class="space-y-4">
        
        <!-- Nama Lengkap -->
        <div>
          <label for="full_name" class="block text-sm font-medium mb-1 text-slate-300">
            Nama Lengkap <span class="text-emerald-400">*</span>
          </label>
          <input 
            type="text" 
            id="full_name" 
            name="full_name" 
            required 
            placeholder="Sesuai kartu identitas"
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 text-slate-100 placeholder-slate-500 text-sm"
          />
        </div>

        <!-- No WhatsApp -->
        <div>
          <label for="phone_number" class="block text-sm font-medium mb-1 text-slate-300">
            No. WhatsApp Aktif <span class="text-emerald-400">*</span>
          </label>
          <input 
            type="tel" 
            id="phone_number" 
            name="phone_number" 
            required 
            placeholder="0812xxxxxxxx"
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 text-slate-100 placeholder-slate-500 text-sm"
          />
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-sm font-medium mb-1 text-slate-300">
            Alamat Email <span class="text-emerald-400">*</span>
          </label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            placeholder="nama@email.com"
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 text-slate-100 placeholder-slate-500 text-sm"
          />
        </div>

        <!-- PERTANYAAN GROUP WHATSAPP -->
        <div class="pt-3 border-t border-slate-700/60">
          <label class="block text-xs font-semibold mb-2 text-slate-200">
            Sudah bergabung di grup WhatsApp Blue Wave Community? <span class="text-emerald-400">*</span>
          </label>
          <div class="flex items-center space-x-6">
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="radio" name="joined_wa" value="sudah" class="wa-radio w-4 h-4 text-emerald-500 bg-slate-700 border-slate-600 focus:ring-emerald-500" required />
              <span class="text-xs font-medium text-slate-200">Sudah</span>
            </label>
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="radio" name="joined_wa" value="belum" class="wa-radio w-4 h-4 text-emerald-500 bg-slate-700 border-slate-600 focus:ring-emerald-500" />
              <span class="text-xs font-medium text-slate-200">Belum</span>
            </label>
          </div>
        </div>

        <!-- SECTION POPUP JOIN WA GROUP -->
        <div id="section2JoinGroup" class="hidden p-3.5 bg-slate-700/40 border border-emerald-500/30 rounded-xl space-y-2.5 transition-all text-xs">
          <h3 class="font-bold text-emerald-400">Join Community WhatsApp</h3>
          <p class="text-slate-300 leading-relaxed text-[11px]">
            Gabung grup komunitas untuk informasi titik kumpul (meeting point), race brief, dan dokumentasi event:
          </p>
          <div>
            <a 
              href="https://chat.whatsapp.com/BAWU2LQlmqCAVZvYWPmHQE" 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-emerald-400 hover:text-emerald-300 underline font-medium break-all"
            >
              https://chat.whatsapp.com/BAWU2LQlmqCAVZvYWPmHQE
            </a>
          </div>

          <div class="pt-2 border-t border-slate-600/50">
            <label class="block font-semibold mb-1 text-slate-200">
              Konfirmasi: Apakah Anda Sudah Join? <span class="text-emerald-400">*</span>
            </label>
            <div class="flex items-center space-x-6">
              <label class="flex items-center space-x-2 cursor-pointer">
                <input type="radio" name="confirm_joined_wa" value="sudah" class="wa-confirm-radio w-4 h-4 text-emerald-500 bg-slate-700 border-slate-600 focus:ring-emerald-500" />
                <span class="font-medium text-slate-200">Sudah</span>
              </label>
              <label class="flex items-center space-x-2 cursor-pointer">
                <input type="radio" name="confirm_joined_wa" value="belum" class="wa-confirm-radio w-4 h-4 text-emerald-500 bg-slate-700 border-slate-600 focus:ring-emerald-500" />
                <span class="font-medium text-slate-200">Belum</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Tombol Submit -->
        <button 
          type="submit" 
          id="submitBtn"
          class="w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 transition duration-150 font-bold rounded-lg text-white shadow-lg shadow-emerald-600/20 mt-4 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Daftar Grab Road to JRF
        </button>
      </form>

    </div>

    <script>
      const waRadios = document.querySelectorAll<HTMLInputElement>('.wa-radio');
      const confirmRadios = document.querySelectorAll<HTMLInputElement>('.wa-confirm-radio');
      const section2 = document.getElementById('section2JoinGroup');
      const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

      function updateFormFlow() {
        const selectedWa = document.querySelector<HTMLInputElement>('.wa-radio:checked')?.value;
        const selectedConfirm = document.querySelector<HTMLInputElement>('.wa-confirm-radio:checked')?.value;

        if (selectedWa === 'sudah') {
          section2?.classList.add('hidden');
          submitBtn.disabled = false;
        } else if (selectedWa === 'belum') {
          section2?.classList.remove('hidden');
          if (selectedConfirm === 'sudah') {
            submitBtn.disabled = false;
          } else {
            submitBtn.disabled = true;
          }
        }
      }

      waRadios.forEach((radio) => radio.addEventListener('change', updateFormFlow));
      confirmRadios.forEach((radio) => radio.addEventListener('change', updateFormFlow));

      updateFormFlow();
    </script>
  </body>
</html>