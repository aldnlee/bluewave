---
import { getSupabase } from '../../lib/supabase';
import '../../styles/global.css';

const locals = Astro.locals as any;
const runtimeEnv = locals?.runtime?.env || locals?.cloudflare?.env;
const supabase = getSupabase(runtimeEnv);

let leaderboard: Array<{
  phone_number: string;
  full_name: string;
  email: string | null;
  total_attended: number;
  total_registered: number;
  eligible_jersey: boolean;
  last_attended_at: string | null;
}> = [];

try {
  const { data, error } = await supabase
    .from('attendance_leaderboard')
    .select('*');

  if (data) leaderboard = data;
} catch (e: any) {
  console.error('Leaderboard Fetch Error:', e.message);
}

const totalEligible = leaderboard.filter(p => p.eligible_jersey).length;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blue Wave - Attendance Leaderboard & Jersey Rewards</title>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen p-4 sm:p-6 font-sans">
    <div class="max-w-6xl mx-auto space-y-6">
      
      <!-- Top Banner Summary -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-900 p-6 rounded-2xl border border-[#005BDF]/30 shadow-xl">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-[#005BDF]/20 text-blue-300 border border-[#005BDF]/40 mb-2">
            <span>Reward Qualification System</span>
          </div>
          <h1 class="text-2xl font-black text-white tracking-tight">BLUE WAVE LEADERBOARD</h1>
          <p class="text-xs text-slate-400 mt-1">Klasifikasi keaktifan sesi latihan dan reward jersey (Minimal 3x Kehadiran On-Site)</p>
        </div>

        <div class="flex items-center gap-3">
          <div class="bg-slate-800 px-4 py-2.5 rounded-xl border border-slate-700 text-center">
            <span class="block text-xs text-slate-400">Total Pelari</span>
            <span class="text-xl font-bold text-white">{leaderboard.length}</span>
          </div>
          <div class="bg-emerald-500/15 px-4 py-2.5 rounded-xl border border-emerald-500/40 text-center">
            <span class="block text-xs text-emerald-300 font-medium">Eligible Jersey (≥3x)</span>
            <span class="text-xl font-black text-emerald-400">{totalEligible}</span>
          </div>
        </div>
      </div>

      <!-- Quick Filter Bar -->
      <div class="flex flex-col sm:flex-row gap-3 bg-slate-900 p-4 rounded-xl border border-slate-800">
        <input 
          type="text" 
          id="searchInput" 
          placeholder="🔍 Cari nama atau no. HP..." 
          class="flex-1 px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-[#005BDF]"
        />
        <select 
          id="eligibilityFilter" 
          class="px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:ring-2 focus:ring-[#005BDF]"
        >
          <option value="all">Semua Peserta</option>
          <option value="eligible">Sudah Berhak Jersey (≥3x)</option>
          <option value="in_progress">Menuju Jersey (1-2x)</option>
        </select>
      </div>

      <!-- Table Leaderboard -->
      <div class="bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-slate-200">
            <thead class="bg-slate-800/80 text-xs uppercase text-slate-400 border-b border-slate-800">
              <tr>
                <th class="px-6 py-4">Rank / Peserta</th>
                <th class="px-6 py-4">Kontak</th>
                <th class="px-6 py-4 text-center">Total Kehadiran</th>
                <th class="px-6 py-4">Status Jersey</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60" id="leaderboardBody">
              {leaderboard.map((item, index) => {
                const progress = Math.min(Math.round((item.total_attended / 3) * 100), 100);
                return (
                  <tr 
                    class="hover:bg-slate-800/40 transition runner-row" 
                    data-name={item.full_name.toLowerCase()} 
                    data-phone={item.phone_number} 
                    data-eligible={item.eligible_jersey ? 'eligible' : 'in_progress'}
                  >
                    <td class="px-6 py-4">
                      <div class="flex items-center gap-3">
                        <span class={`w-6 h-6 rounded-full flex items-center justify-center text-xs font-black ${
                          index === 0 ? 'bg-amber-400 text-black' :
                          index === 1 ? 'bg-slate-300 text-black' :
                          index === 2 ? 'bg-amber-600 text-white' : 'bg-slate-800 text-slate-400'
                        }`}>
                          {index + 1}
                        </span>
                        <div>
                          <div class="font-bold text-white">{item.full_name}</div>
                          <div class="text-[11px] text-slate-400">Total Daftar: {item.total_registered} sesi</div>
                        </div>
                      </div>
                    </td>
                    <td class="px-6 py-4">
                      <div class="text-xs text-slate-300 font-mono">{item.phone_number}</div>
                      {item.email && <div class="text-xs text-[#005BDF] font-mono">{item.email}</div>}
                    </td>
                    <td class="px-6 py-4 text-center">
                      <div class="inline-flex flex-col items-center">
                        <span class="text-base font-black text-white">
                          {item.total_attended} <span class="text-xs text-slate-500 font-normal">/ 3 sesi</span>
                        </span>
                        <div class="w-20 bg-slate-800 h-1.5 rounded-full overflow-hidden mt-1">
                          <div 
                            class={`h-full rounded-full ${item.eligible_jersey ? 'bg-emerald-400' : 'bg-[#005BDF]'}`} 
                            style={`width: ${progress}%;`}
                          ></div>
                        </div>
                      </div>
                    </td>
                    <td class="px-6 py-4">
                      {item.eligible_jersey ? (
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/40">
                          <span>🎽</span> Claim Jersey
                        </span>
                      ) : (
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-slate-800 text-slate-400 border border-slate-700">
                          Kurang {3 - item.total_attended} sesi lagi
                        </span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- Client-side filter script -->
    <script>
      const searchInput = document.getElementById('searchInput') as HTMLInputElement;
      const eligibilityFilter = document.getElementById('eligibilityFilter') as HTMLSelectElement;
      const rows = document.querySelectorAll<HTMLTableRowElement>('.runner-row');

      function filterLeaderboard() {
        const query = searchInput.value.toLowerCase().trim();
        const selected = eligibilityFilter.value;

        rows.forEach(row => {
          const name = row.getAttribute('data-name') || '';
          const phone = row.getAttribute('data-phone') || '';
          const eligible = row.getAttribute('data-eligible') || '';

          const matchesQuery = name.includes(query) || phone.includes(query);
          const matchesEligible = selected === 'all' || eligible === selected;

          row.style.display = (matchesQuery && matchesEligible) ? '' : 'none';
        });
      }

      searchInput?.addEventListener('input', filterLeaderboard);
      eligibilityFilter?.addEventListener('change', filterLeaderboard);
    </script>
  </body>
</html>