---
import { getSupabase } from '../lib/supabase';
import '../styles/global.css';

let message = '';
let isSuccess = false;

// Safe extraction runtime environment Cloudflare / Vite Local
const locals = Astro.locals as any;
const runtimeEnv = locals?.runtime?.env || locals?.cloudflare?.env;
const supabase = getSupabase(runtimeEnv);

// ID Sesi Kampanye Khusus yang dikecualikan dari dropdown reguler
const RTUIHM_SESSION_ID = '66666666-6666-4666-a666-666666666666';

let sessions: Array<{ id: string; title: string; session_date: string; max_capacity: number }> = [];

// Format tanggal hari ini (YYYY-MM-DD)
const today = new Date().toISOString().split('T')[0];

// Tangkap Form Submission di Server (SSR)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();

    const sessionId = formData.get('session_id')?.toString()?.trim();
    const fullName = formData.get('full_name')?.toString()?.trim();
    const phoneNumber = formData.get('phone_number')?.toString()?.trim();
    const email = formData.get('email')?.toString()?.trim();
    const tier = 'bluewave';

    if (!sessionId || sessionId === '') {
      message = 'Silakan pilih sesi latihan terlebih dahulu!';
    } else if (fullName && phoneNumber && email) {
      // Panggil Stored Procedure register_bluewave_session
      const { data, error } = await supabase.rpc('register_bluewave_session', {
        p_session_id: sessionId,
        p_full_name: fullName,
        p_phone_number: phoneNumber,
        p_tier: tier,
        p_email: email,
      });

      if (error) {
        message = `Gagal memproses pendaftaran: ${error.message}`;
      } else if (data && !data.success) {
        message = data.message;
      } else if (data && data.success) {
        message = data.message || 'Pendaftaran berhasil!';
        isSuccess = true;
      }
    } else {
      message = 'Harap isi semua kolom wajib!';
    }
  } catch (err: any) {
    message = `Terjadi kesalahan sistem: ${err.message}`;
  }
}

// Fetch hanya sesi reguler yang belum lewat (kecualikan RTUIHM)
try {
  const { data, error } = await supabase
    .from('sessions')
    .select('id, title, session_date, max_capacity')
    .gte('session_date', today)
    .neq('id', RTUIHM_SESSION_ID)
    .order('session_date', { ascending: true });

  if (!error && data) {
    sessions = data;
  } else if (error) {
    console.error('Error fetching sessions:', error.message);
  }
} catch (e: any) {
  console.error('Init Error:', e.message);
}
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BLUE WAVE REGISTRATION</title>
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4 font-sans selection:bg-[#005BDF] selection:text-white">
    <div class="max-w-lg w-full bg-slate-800/90 backdrop-blur-md p-6 sm:p-8 rounded-2xl shadow-2xl border border-slate-700">
      
      <!-- Header & Warning Note -->
      <div class="text-center mb-6">
  <h1 class="text-3xl font-black text-[#005BDF] tracking-tight">BLUE WAVE REGISTRATION</h1>

  <!-- POPPING SPECIAL CHALLENGE CARD -->
  <div class="relative mt-5 overflow-hidden rounded-2xl border border-[#005BDF]/40 bg-gradient-to-br from-[#005BDF]/20 via-slate-800/90 to-slate-900 p-4 sm:p-5 text-left shadow-lg shadow-[#005BDF]/15 transition duration-300 hover:border-[#005BDF] hover:shadow-[#005BDF]/25">
    
    <!-- Decorative Glow Accent -->
    <div class="pointer-events-none absolute -top-8 -right-8 h-24 w-24 rounded-full bg-[#005BDF]/30 blur-2xl"></div>

    <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-3.5">
      <div class="space-y-1.5 flex-1">
        <!-- Tag / Badge -->
        <div class="inline-flex items-center gap-1.5 rounded-full bg-[#005BDF] px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-white shadow-sm">
          <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-cyan-300"></span>
          Special Challenge
        </div>
        
        <!-- Challenge Title -->
        <h3 class="text-base font-extrabold text-white tracking-tight">
          GRAB YOUR MILES
        </h3>

        <!-- Description -->
        <p class="text-xs text-slate-300 leading-relaxed">
          Buat akun di platform resmi dan selesaikan aktivasinya untuk mulai mengumpulkan jarak tempuh kamu.
        </p>
      </div>

      <!-- Action Button -->
      <div class="pt-1 sm:pt-0">
        <a 
          href="https://grab.gofit.id" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1.5 w-full sm:w-auto px-4 py-2.5 rounded-xl bg-[#005BDF] hover:bg-[#004bb8] text-white text-xs font-bold shadow-md shadow-[#005BDF]/30 transition transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>Daftar Sekarang</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

      <!-- Alert Message -->
      {message && (
        <div class={`p-4 rounded-xl mb-6 text-sm font-medium border ${
          isSuccess 
            ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' 
            : 'bg-rose-500/10 text-rose-400 border-rose-500/30'
        }`}>
          {message}
        </div>
      )}

      <form method="POST" id="registrationForm" class="space-y-5">
        
        <!-- Pilihan Sesi -->
        <div>
          <label for="session_id" class="block text-sm font-medium mb-2 text-slate-300">
            Pilih Sesi Latihan <span class="text-rose-400">*</span>
          </label>
          <select 
            id="session_id" 
            name="session_id" 
            required 
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#005BDF] text-slate-100"
          >
            <option value="" class="bg-slate-800 text-slate-300">
              {sessions.length > 0 ? '-- Pilih Sesi --' : '-- Tidak ada sesi aktif --'}
            </option>
            {sessions.map((session) => (
              <option value={session.id} class="bg-slate-800 text-slate-100">
                {session.title} ({session.session_date})
              </option>
            ))}
          </select>
        </div>

        <!-- Nama Lengkap -->
        <div>
          <label for="full_name" class="block text-sm font-medium mb-2 text-slate-300">
            Nama Lengkap <span class="text-rose-400">*</span>
          </label>
          <input 
            type="text" 
            id="full_name" 
            name="full_name" 
            required 
            placeholder="Masukkan Nama Lengkap"
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#005BDF] text-slate-100 placeholder-slate-500"
          />
        </div>

        <!-- No HP / WhatsApp -->
        <div>
          <label for="phone_number" class="block text-sm font-medium mb-2 text-slate-300">
            No. Telpon / WhatsApp <span class="text-rose-400">*</span>
          </label>
          <input 
            type="tel" 
            id="phone_number" 
            name="phone_number" 
            required 
            placeholder="08123456789"
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#005BDF] text-slate-100 placeholder-slate-500"
          />
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-sm font-medium mb-2 text-slate-300">
            Alamat Email <span class="text-rose-400">*</span>
          </label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            placeholder="nama@email.com"
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#005BDF] text-slate-100 placeholder-slate-500"
          />
        </div>

        <!-- Pertanyaan Group WhatsApp -->
        <div class="pt-2 border-t border-slate-700/60">
          <label class="block text-sm font-semibold mb-3 text-slate-200">
            Apakah Anda sudah bergabung di group Whatsapp Blue Wave? <span class="text-rose-400">*</span>
          </label>
          <div class="flex items-center space-x-6">
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="radio" name="joined_wa" value="sudah" class="wa-radio w-4 h-4 text-[#005BDF] bg-slate-700 border-slate-600 focus:ring-[#005BDF]" required />
              <span class="text-sm font-medium text-slate-200">Sudah</span>
            </label>
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="radio" name="joined_wa" value="belum" class="wa-radio w-4 h-4 text-[#005BDF] bg-slate-700 border-slate-600 focus:ring-[#005BDF]" />
              <span class="text-sm font-medium text-slate-200">Belum</span>
            </label>
          </div>
        </div>

        <!-- Section 2: Join Blue Wave Group -->
        <div id="section2JoinGroup" class="hidden p-4 bg-slate-700/40 border border-[#005BDF]/30 rounded-xl space-y-3 transition-all">
          <h3 class="text-base font-bold text-blue-400">Join Blue Wave Group</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Silakan bergabung ke grup WhatsApp Blue Wave melalui tautan di bawah ini untuk mendapatkan informasi terbaru seputar jadwal latihan, aktivitas komunitas, dan berbagai update lainnya.
          </p>
          <div class="pt-1">
            <p class="text-xs font-semibold text-slate-400 mb-1">Link Grup WhatsApp Blue Wave:</p>
            <a 
              href="https://chat.whatsapp.com/BAWU2LQlmqCAVZvYWPmHQE" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-blue-400 hover:text-blue-300 underline font-medium break-all"
            >
              https://chat.whatsapp.com/BAWU2LQlmqCAVZvYWPmHQE
            </a>
          </div>

          <div class="pt-3 border-t border-slate-600/50">
            <label class="block text-xs font-semibold mb-2 text-slate-200">
              Apakah Anda Sudah Join? <span class="text-rose-400">*</span>
            </label>
            <div class="flex items-center space-x-6">
              <label class="flex items-center space-x-2 cursor-pointer">
                <input type="radio" name="confirm_joined_wa" value="sudah" class="wa-confirm-radio w-4 h-4 text-[#005BDF] bg-slate-700 border-slate-600 focus:ring-[#005BDF]" />
                <span class="text-xs font-medium text-slate-200">Sudah</span>
              </label>
              <label class="flex items-center space-x-2 cursor-pointer">
                <input type="radio" name="confirm_joined_wa" value="belum" class="wa-confirm-radio w-4 h-4 text-[#005BDF] bg-slate-700 border-slate-600 focus:ring-[#005BDF]" />
                <span class="text-xs font-medium text-slate-200">Belum</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <button 
          type="submit" 
          id="submitBtn"
          class="w-full py-3 px-4 bg-[#005BDF] hover:bg-[#004bb8] active:bg-[#003d96] transition duration-150 font-semibold rounded-lg text-white shadow-lg shadow-[#005BDF]/20 mt-4 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
        >
          Kirim Pendaftaran
        </button>
      </form>

    </div>

    <!-- Client-Side Logic -->
    <script>
      const waRadios = document.querySelectorAll<HTMLInputElement>('.wa-radio');
      const confirmRadios = document.querySelectorAll<HTMLInputElement>('.wa-confirm-radio');
      const section2 = document.getElementById('section2JoinGroup');
      const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

      function updateFormFlow() {
        const selectedWa = document.querySelector<HTMLInputElement>('.wa-radio:checked')?.value;
        const selectedConfirm = document.querySelector<HTMLInputElement>('.wa-confirm-radio:checked')?.value;

        if (selectedWa === 'sudah') {
          section2?.classList.add('hidden');
          submitBtn.disabled = false;
        } else if (selectedWa === 'belum') {
          section2?.classList.remove('hidden');
          if (selectedConfirm === 'sudah') {
            submitBtn.disabled = false;
          } else {
            submitBtn.disabled = true;
          }
        }
      }

      waRadios.forEach((radio) => radio.addEventListener('change', updateFormFlow));
      confirmRadios.forEach((radio) => radio.addEventListener('change', updateFormFlow));

      updateFormFlow();
    </script>
  </body>
</html>