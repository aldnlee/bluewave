---
import { getSupabase } from '../lib/supabase';

let message = '';
let isSuccess = false;

// Ambil runtime environment dari Cloudflare adapter jika tersedia
const runtimeEnv = (Astro.locals as any)?.runtime?.env;

// Fetch daftar sesi aktif dari Supabase untuk dropdown pilihan
let sessions: Array<{ id: string; title: string; session_date: string; max_capacity: number }> = [];

try {
  const supabase = getSupabase(runtimeEnv);
  const { data, error } = await supabase
    .from('sessions')
    .select('id, title, session_date, max_capacity')
    .order('session_date', { ascending: true });

  if (!error && data) {
    sessions = data;
  }
} catch (e: any) {
  console.error('Error fetching sessions:', e.message);
}

// Tangkap Form Submission di Server (SSR)
if (Astro.request.method === 'POST') {
  try {
    const supabase = getSupabase(runtimeEnv);
    const formData = await Astro.request.formData();

    const sessionId = formData.get('session_id')?.toString();
    const fullName = formData.get('full_name')?.toString();
    const phoneNumber = formData.get('phone_number')?.toString();
    const tier = formData.get('tier')?.toString() || 'public';

    if (sessionId && fullName && phoneNumber) {
      // Panggil Stored Procedure untuk registrasi aman (Cek Kuota + Insert 1 Transaksi)
      const { data, error } = await supabase.rpc('register_bluewave_session', {
        p_session_id: sessionId,
        p_full_name: fullName,
        p_phone_number: phoneNumber,
        p_tier: tier,
      });

      if (error) {
        message = `Gagal memproses pendaftaran: ${error.message}`;
      } else if (data && !data.success) {
        // Pesan gagal dari Stored Procedure (misal: "Kuota penuh" atau "Nomor HP sudah terdaftar")
        message = data.message;
      } else if (data && data.success) {
        message = data.message || 'Pendaftaran berhasil!';
        isSuccess = true;
      }
    } else {
      message = 'Harap isi semua kolom wajib!';
    }
  } catch (err: any) {
    message = `Terjadi kesalahan sistem: ${err.message}`;
  }
}
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pendaftaran Sesi Latihan Blue Wave</title>
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4 font-sans">
    <div class="max-w-lg w-full bg-slate-800 p-8 rounded-2xl shadow-xl border border-slate-700">
      
      <div class="text-center mb-8">
        <h1 class="text-3xl font-extrabold text-blue-400 tracking-tight">BLUE WAVE</h1>
        <p class="text-slate-400 text-sm mt-1">Form Pendaftaran Sesi Latihan Reguler</p>
      </div>

      {message && (
        <div class={`p-4 rounded-xl mb-6 text-sm font-medium border ${
          isSuccess 
            ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' 
            : 'bg-rose-500/10 text-rose-400 border-rose-500/30'
        }`}>
          {message}
        </div>
      )}

      <form method="POST" class="space-y-5">
        <div>
          <label for="session_id" class="block text-sm font-medium mb-2 text-slate-300">
            Pilih Sesi Latihan <span class="text-rose-400">*</span>
          </label>
          <select 
            id="session_id" 
            name="session_id" 
            required 
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-100"
          >
            <option value="">-- Pilih Sesi --</option>
            {sessions.map((session) => (
              <option value={session.id}>
                {session.title} ({session.session_date})
              </option>
            ))}
          </select>
        </div>

        <div>
          <label for="full_name" class="block text-sm font-medium mb-2 text-slate-300">
            Nama Lengkap <span class="text-rose-400">*</span>
          </label>
          <input 
            type="text" 
            id="full_name" 
            name="full_name" 
            required 
            placeholder="Contoh: Alex Rian"
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-100 placeholder-slate-500"
          />
        </div>

        <div>
          <label for="phone_number" class="block text-sm font-medium mb-2 text-slate-300">
            Nomor WhatsApp / HP <span class="text-rose-400">*</span>
          </label>
          <input 
            type="tel" 
            id="phone_number" 
            name="phone_number" 
            required 
            placeholder="08123456789"
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-100 placeholder-slate-500"
          />
        </div>

        <div>
          <label for="tier" class="block text-sm font-medium mb-2 text-slate-300">
            Kategori Peserta
          </label>
          <select 
            id="tier" 
            name="tier" 
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-100"
          >
            <option value="public">Umum / Public</option>
            <option value="community_internal">Internal Komunitas</option>
            <option value="bluewave_runner">Blue Wave Runner</option>
          </select>
        </div>

        <button 
          type="submit" 
          class="w-full py-3 px-4 bg-blue-600 hover:bg-blue-500 active:bg-blue-700 transition duration-150 font-semibold rounded-lg text-white shadow-lg shadow-blue-600/20 mt-2"
        >
          Kirim Pendaftaran
        </button>
      </form>

    </div>
  </body>
</html>