---
// index.astro sederhana tanpa SSR/Database dulu
---

<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Blue Wave Running Club</title>
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background-color: #111827;
      color: #ffffff;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
    }
    .card {
      background-color: #1f2937;
      padding: 2rem;
      border-radius: 12px;
      border: 1px solid #374151;
      max-width: 400px;
      width: 100%;
      text-align: center;
    }
    h1 { color: #60a5fa; margin-bottom: 0.5rem; }
    p { color: #9ca3af; margin-bottom: 1.5rem; }
    .status {
      background-color: #10b98120;
      color: #34d399;
      padding: 0.5rem 1rem;
      border-radius: 6px;
      display: inline-block;
      font-size: 0.875rem;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>Blue Wave Running Club</h1>
    <p>Sistem Pendaftaran Latihan Reguler</p>
    <div class="status">
      ✓ Server Astro & Cloudflare Pages Berhasil Terhubung!
    </div>
  </div>
</body>
</html>