---
import { supabase } from '../lib/supabase';

let message = '';
let isSuccess = false;

// Tangkap Form Submission di Server (SSR)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const name = formData.get('name')?.toString();
    const email = formData.get('email')?.toString();

    if (name && email) {
      // Insert data ke tabel 'registrations' di Supabase
      const { error } = await supabase
        .from('registrations')
        .insert([{ name, email }]);

      if (error) {
        message = `Gagal menyimpan: ${error.message}`;
      } else {
        message = 'Pendaftaran berhasil dikirim!';
        isSuccess = true;
      }
    } else {
      message = 'Harap isi semua kolom!';
    }
  } catch (err: any) {
    message = `Terjadi kesalahan: ${err.message}`;
  }
}
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Form Pendaftaran Blue Wave</title>
  </head>
  <body class="bg-slate-900 text-white min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-slate-800 p-6 rounded-xl shadow-lg">
      <h1 class="text-2xl font-bold mb-6 text-center text-blue-400">Pendaftaran Blue Wave</h1>

      {message && (
        <div class={`p-3 rounded mb-4 text-sm ${isSuccess ? 'bg-green-600/20 text-green-400 border border-green-500' : 'bg-red-600/20 text-red-400 border border-red-500'}`}>
          {message}
        </div>
      )}

      <form method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1">Nama Lengkap</label>
          <input 
            type="text" 
            name="name" 
            required 
            class="w-full px-3 py-2 bg-slate-700 rounded border border-slate-600 focus:outline-none focus:border-blue-500 text-white" 
            placeholder="Masukkan nama"
          />
        </div>

        <div>
          <label class="block text-sm font-medium mb-1">Email</label>
          <input 
            type="email" 
            name="email" 
            required 
            class="w-full px-3 py-2 bg-slate-700 rounded border border-slate-600 focus:outline-none focus:border-blue-500 text-white" 
            placeholder="nama@email.com"
          />
        </div>

        <button 
          type="submit" 
          class="w-full py-2 bg-blue-600 hover:bg-blue-500 transition font-semibold rounded text-white"
        >
          Kirim Pendaftaran
        </button>
      </form>
    </div>
  </body>
</html>