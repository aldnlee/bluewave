---
import { supabase } from '../lib/supabase';

// Fetch sesi latihan terdekat dari Supabase
const { data: currentSession } = await supabase
  .from('sessions')
  .select('id, title, session_date, max_capacity')
  .gte('session_date', new Date().toISOString().split('T')[0])
  .order('session_date', { ascending: true })
  .limit(1)
  .single();

let totalRegistered = 0;
if (currentSession) {
  const { count } = await supabase
    .from('registrations')
    .select('*', { count: 'exact', head: true })
    .eq('session_id', currentSession.id);
  totalRegistered = count || 0;
}

const isFull = currentSession ? totalRegistered >= currentSession.max_capacity : true;
const url = new URL(Astro.request.url);
const presetTier = url.searchParams.get('tier') || 'public';
---

<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Latihan Reguler Blue Wave</title>
</head>
<body style="font-family: sans-serif; padding: 20px; max-width: 500px; margin: auto;">
  <h1>Blue Wave Running Club</h1>
  <p>Pendaftaran Latihan Reguler</p>

  {currentSession ? (
    <div>
      <h3>{currentSession.title}</h3>
      <p>Tanggal: {currentSession.session_date}</p>
      <p>Kuota Terisi: {totalRegistered} / {currentSession.max_capacity}</p>

      {!isFull ? (
        <form action="/api/register" method="POST" style="display: flex; flex-direction: column; gap: 10px;">
          <input type="hidden" name="session_id" value={currentSession.id} />
          
          <label>Nama Lengkap:
            <input type="text" name="full_name" required style="width: 100%;" />
          </label>
          
          <label>Nomor WhatsApp:
            <input type="tel" name="phone_number" required style="width: 100%;" />
          </label>
          
          <label>Kategori Peserta:
            <select name="tier" style="width: 100%;">
              <option value="public" selected={presetTier === 'public'}>Public</option>
              <option value="community_internal" selected={presetTier === 'community_internal'}>Community Partner</option>
              <option value="bluewave_runner" selected={presetTier === 'bluewave_runner'}>Blue Wave Core</option>
            </select>
          </label>

          <button type="submit" style="padding: 10px; cursor: pointer;">Daftar Latihan</button>
        </form>
      ) : (
        <p style="color: red;">Mohon maaf, kuota latihan sesi ini penuh!</p>
      )}
    </div>
  ) : (
    <p>Belum ada jadwal latihan aktif.</p>
  )}
</body>
</html>