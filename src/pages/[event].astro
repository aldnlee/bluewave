---
import { getSupabase } from '../lib/supabase';
import '../styles/global.css';

let message = '';
let isSuccess = false;

// Safe extraction runtime environment Cloudflare / Vite Local
const locals = Astro.locals as any;
const runtimeEnv = locals?.runtime?.env || locals?.cloudflare?.env;
const supabase = getSupabase(runtimeEnv);

// Tangkap parameter "event" dari URL (misal: /bluewaveday, /wave, /indomaret)
const { event } = Astro.params;
const slug = (event || '').toLowerCase();
const isBlueWaveDay = slug === 'bluewaveday' || slug === 'blue-wave-day';

let sessions: Array<{ id: string; title: string; session_date: string }> = [];

// Format tanggal hari ini (YYYY-MM-DD)
const today = new Date().toISOString().split('T')[0];

// Handle Form Submission (SSR)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();

    // Ambil semua session_id yang dipilih
    const sessionIds = formData.getAll('session_id').map((id) => id.toString().trim()).filter(Boolean);
    const fullName = formData.get('full_name')?.toString()?.trim();
    const phoneNumber = formData.get('phone_number')?.toString()?.trim();
    const email = formData.get('email')?.toString()?.trim();
    const rawCommunity = formData.get('community')?.toString()?.trim();
    
    // Jika kolom komunitas dikosongkan, otomatis diisi 'Umum'
    const community = rawCommunity && rawCommunity.length > 0 ? rawCommunity : 'Umum';
    const tier = slug || 'bluewave';

    if (sessionIds.length === 0) {
      message = 'Silakan pilih minimal 1 sesi latihan terlebih dahulu!';
    } else if (fullName && phoneNumber && email) {
      const failedMessages: string[] = [];
      let successCount = 0;

      for (const sId of sessionIds) {
        const { data, error } = await supabase.rpc('register_bluewave_session', {
          p_session_id: sId,
          p_full_name: fullName,
          p_phone_number: phoneNumber,
          p_tier: tier,
          p_email: email,
          p_community: community,
        });

        if (error) {
          failedMessages.push(error.message);
        } else if (data && !data.success) {
          failedMessages.push(data.message);
        } else if (data && data.success) {
          successCount++;
        }
      }

      if (successCount > 0) {
        isSuccess = true;
        if (isBlueWaveDay) {
          message = `Pendaftaran berhasil untuk ${successCount} sesi Blue Wave Day (${community})!${
            failedMessages.length > 0 ? ` (Catatan: ${failedMessages.join(', ')})` : ''
          }`;
        } else {
          message = `Pendaftaran berhasil! Kategori peserta: ${community}.`;
        }
      } else {
        message = failedMessages.join(' | ') || 'Gagal memproses pendaftaran.';
      }
    } else {
      message = 'Harap isi semua kolom wajib!';
    }
  } catch (err: any) {
    message = `Terjadi kesalahan sistem: ${err.message}`;
  }
}

// FETCH SESSIONS BERDASARKAN PARAMETER URL (Tanpa mengekspos max_capacity ke user)
try {
  const isUUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(event || '');

  let query = supabase
    .from('sessions')
    .select('id, title, session_date')
    .gte('session_date', today)
    .order('session_date', { ascending: true })
    .order('title', { ascending: true });

  if (isUUID) {
    query = query.eq('id', event);
  } else if (slug === 'indomaret' || slug === 'indomaret-run') {
    query = query.ilike('title', '%Indomaret%');
  } else if (isBlueWaveDay) {
    query = query.ilike('title', '%Blue Wave Day%');
  } else if (slug === 'cheering') {
    query = query.ilike('title', '%Cheering%');
  } else if (slug === 'shakeout') {
    query = query.ilike('title', '%Shakeout%');
  } else {
    query = query
      .ilike('title', '%Wave%')
      .not('title', 'ilike', '%Blue Wave Day%')
      .not('title', 'ilike', '%Indomaret%')
      .not('title', 'ilike', '%Shakeout%');
  }

  const { data, error } = await query;

  if (!error && data) {
    sessions = data;
  } else if (error) {
    console.error('Error fetching sessions:', error.message);
  }
} catch (e: any) {
  console.error('Init Error:', e.message);
}

// Grouping per tanggal khusus untuk tampilan Blue Wave Day
const groupedByDate = sessions.reduce((acc, session) => {
  const date = session.session_date;
  if (!acc[date]) acc[date] = [];
  acc[date].push(session);
  return acc;
}, {} as Record<string, typeof sessions>);

const sortedDates = Object.keys(groupedByDate).sort();

function formatDayLabel(dateStr: string) {
  const d = new Date(`${dateStr}T00:00:00`);
  return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
}

const eventTitle = isBlueWaveDay
  ? 'BLUE WAVE DAY'
  : (event || 'BLUE WAVE').replace(/-/g, ' ').toUpperCase();
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>REGISTRASI - {eventTitle}</title>
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4 font-sans selection:bg-[#005BDF] selection:text-white">
    <div class="max-w-lg w-full bg-slate-800/90 backdrop-blur-md p-6 sm:p-8 rounded-2xl shadow-2xl border border-slate-700">
      
      <!-- Header -->
      <div class="text-center mb-6">
        <h1 class="text-3xl font-black text-[#005BDF] tracking-tight">{eventTitle} REGISTRATION</h1>
        {isBlueWaveDay ? (
          <p class="text-xs text-slate-300 mt-2 leading-relaxed">
            Zona Blu x Gofit • <span class="text-blue-400 font-semibold">#AdeminProgresmu</span> biar <span class="text-blue-400 font-semibold">#OnTerus</span>
          </p>
        ) : (
          <p class="text-xs text-slate-400 mt-2">
            Lengkapi data diri di bawah untuk mengamankan slot latihan Anda
          </p>
        )}
      </div>

      <!-- Alert Message -->
      {message && (
        <div class={`p-4 rounded-xl mb-6 text-sm font-medium border ${
          isSuccess 
            ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' 
            : 'bg-rose-500/10 text-rose-400 border-rose-500/30'
        }`}>
          {message}
        </div>
      )}

      <form method="POST" id="registrationForm" class="space-y-5">
        
        <!-- Pilihan Sesi: Multi-Select per Hari untuk Blue Wave Day vs Dropdown untuk Reguler -->
        {isBlueWaveDay ? (
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <label class="block text-sm font-medium text-slate-300">
                Pilih Aktivitas <span class="text-rose-400">*</span>
              </label>
              <span class="text-[11px] text-blue-400 font-medium">Bisa pilih lebih dari 1 sesi</span>
            </div>

            {sortedDates.length === 0 ? (
              <div class="p-4 rounded-xl bg-slate-700/40 border border-slate-600 text-xs text-slate-400 text-center">
                Belum ada jadwal Blue Wave Day yang aktif.
              </div>
            ) : (
              <div class="space-y-3">
                {sortedDates.map((date, idx) => (
                  <div class="p-3.5 rounded-xl bg-slate-900/70 border border-slate-700/80 space-y-2.5">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                      <span class="text-xs font-extrabold uppercase tracking-wider text-[#005BDF]">
                        DAY {idx + 1} • {formatDayLabel(date)}
                      </span>
                      <span class="text-[11px] font-mono text-slate-400">Zona Blu x Gofit</span>
                    </div>

                    <div class="space-y-2">
                      {groupedByDate[date].map((act) => {
                        const cleanTitle = act.title.replace(/^Blue Wave Day\s*-\s*Day\s*\d+\s*:\s*/i, '');
                        return (
                          <label class="flex items-center gap-3 p-3 rounded-lg bg-slate-800/70 hover:bg-slate-800 border border-slate-700/70 cursor-pointer transition">
                            <input 
                              type="checkbox" 
                              name="session_id" 
                              value={act.id} 
                              class="bwd-checkbox w-4 h-4 rounded text-[#005BDF] bg-slate-700 border-slate-600 focus:ring-[#005BDF] shrink-0"
                            />
                            <div class="text-xs font-bold text-slate-100 leading-snug">
                              {cleanTitle}
                            </div>
                          </label>
                        );
                      })}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        ) : (
          <div>
            <label for="session_id" class="block text-sm font-medium mb-2 text-slate-300">
              Pilih Sesi Latihan <span class="text-rose-400">*</span>
            </label>
            <select 
              id="session_id" 
              name="session_id" 
              required 
              class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#005BDF] text-slate-100"
            >
              <option value="" class="bg-slate-800 text-slate-300">
                {sessions.length > 0 ? '-- Pilih Sesi --' : '-- Tidak ada sesi aktif untuk event ini --'}
              </option>
              {sessions.map((session) => (
                <option value={session.id} class="bg-slate-800 text-slate-100">
                  {session.title} ({session.session_date})
                </option>
              ))}
            </select>
          </div>
        )}

        <!-- Nama Lengkap -->
        <div>
          <label for="full_name" class="block text-sm font-medium mb-2 text-slate-300">
            Nama Lengkap <span class="text-rose-400">*</span>
          </label>
          <input 
            type="text" 
            id="full_name" 
            name="full_name" 
            required 
            placeholder="Masukkan Nama Lengkap"
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#005BDF] text-slate-100 placeholder-slate-500"
          />
        </div>

        <!-- No HP / WhatsApp -->
        <div>
          <label for="phone_number" class="block text-sm font-medium mb-2 text-slate-300">
            No. Telpon / WhatsApp <span class="text-rose-400">*</span>
          </label>
          <input 
            type="tel" 
            id="phone_number" 
            name="phone_number" 
            required 
            placeholder="08123456789"
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#005BDF] text-slate-100 placeholder-slate-500"
          />
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-sm font-medium mb-2 text-slate-300">
            Alamat Email <span class="text-rose-400">*</span>
          </label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            placeholder="nama@email.com"
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#005BDF] text-slate-100 placeholder-slate-500"
          />
        </div>

        <!-- Asal Komunitas (Opsional -> Kosong = Umum) -->
        <div>
          <label for="community" class="block text-sm font-medium mb-1.5 text-slate-300">
            Apakah kamu dari komunitas? <span class="text-xs font-normal text-slate-400">(Opsional)</span>
          </label>
          <input 
            type="text" 
            id="community" 
            name="community" 
            placeholder="Ketik nama komunitas (kosongkan jika umum)"
            class="w-full px-4 py-2.5 bg-slate-700/60 border border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#005BDF] text-slate-100 placeholder-slate-500"
          />
          <p class="text-[11px] text-slate-400 mt-1.5">
            Jika ya, silakan ketik asal komunitasmu (cth: Blue Wave). Jika tidak ada, kosongkan saja (otomatis terdaftar sebagai <strong class="text-slate-300">Umum</strong>).
          </p>
        </div>

        <!-- Pertanyaan Group WhatsApp -->
        <div class="pt-2 border-t border-slate-700/60">
          <label class="block text-sm font-semibold mb-3 text-slate-200">
            Apakah Anda sudah bergabung di group Whatsapp Blue Wave? <span class="text-rose-400">*</span>
          </label>
          <div class="flex items-center space-x-6">
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="radio" name="joined_wa" value="sudah" class="wa-radio w-4 h-4 text-[#005BDF] bg-slate-700 border-slate-600 focus:ring-[#005BDF]" required />
              <span class="text-sm font-medium text-slate-200">Sudah</span>
            </label>
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="radio" name="joined_wa" value="belum" class="wa-radio w-4 h-4 text-[#005BDF] bg-slate-700 border-slate-600 focus:ring-[#005BDF]" />
              <span class="text-sm font-medium text-slate-200">Belum</span>
            </label>
          </div>
        </div>

        <!-- Section 2: Join Blue Wave Group -->
        <div id="section2JoinGroup" class="hidden p-4 bg-slate-700/40 border border-[#005BDF]/30 rounded-xl space-y-3 transition-all">
          <h3 class="text-base font-bold text-blue-400">Join Blue Wave Community Group</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Silakan bergabung ke grup WhatsApp Blue Wave melalui tautan di bawah ini untuk mendapatkan informasi terbaru seputar jadwal latihan, aktivitas komunitas, dan berbagai update lainnya.
          </p>
          <div class="pt-1">
            <p class="text-xs font-semibold text-slate-400 mb-1">Link Grup WhatsApp Blue Wave:</p>
            <a 
              href="https://chat.whatsapp.com/BAWU2LQlmqCAVZvYWPmHQE" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-blue-400 hover:text-blue-300 underline font-medium break-all"
            >
              https://chat.whatsapp.com/BAWU2LQlmqCAVZvYWPmHQE
            </a>
          </div>

          <div class="pt-3 border-t border-slate-600/50">
            <label class="block text-xs font-semibold mb-2 text-slate-200">
              Apakah Anda Sudah Join? <span class="text-rose-400">*</span>
            </label>
            <div class="flex items-center space-x-6">
              <label class="flex items-center space-x-2 cursor-pointer">
                <input type="radio" name="confirm_joined_wa" value="sudah" class="wa-confirm-radio w-4 h-4 text-[#005BDF] bg-slate-700 border-slate-600 focus:ring-[#005BDF]" />
                <span class="text-xs font-medium text-slate-200">Sudah</span>
              </label>
              <label class="flex items-center space-x-2 cursor-pointer">
                <input type="radio" name="confirm_joined_wa" value="belum" class="wa-confirm-radio w-4 h-4 text-[#005BDF] bg-slate-700 border-slate-600 focus:ring-[#005BDF]" />
                <span class="text-xs font-medium text-slate-200">Belum</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <button 
          type="submit" 
          id="submitBtn"
          class="w-full py-3 px-4 bg-[#005BDF] hover:bg-[#004bb8] active:bg-[#003d96] transition duration-150 font-semibold rounded-lg text-white shadow-lg shadow-[#005BDF]/20 mt-4 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
        >
          Kirim Pendaftaran
        </button>
      </form>

      <!-- Info Download Aplikasi Blue Wave / blu (On-Ground Activation) -->
      <div class="mt-6 pt-5 border-t border-slate-700/70">
        <div class="p-4 rounded-xl bg-slate-900/80 border border-[#005BDF]/40 space-y-3">
          <div class="flex items-start gap-2.5">
            <span class="text-base leading-none mt-0.5">📱</span>
            <div class="space-y-1">
              <h3 class="text-xs font-extrabold uppercase tracking-wider text-blue-400">
                Info On-Ground Activation
              </h3>
              <p class="text-xs text-slate-300 leading-relaxed">
                Saat hadir di lokasi (<em>on-ground activation</em>), peserta diwajibkan sudah mengunduh aplikasi <strong class="text-white">Blue Wave / blu by BCA Digital</strong> untuk keperluan aktivitas dan verifikasi di lokasi.
              </p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-2.5 pt-1">
            <!-- Google Play Store Button -->
            <a 
              href="https://play.google.com/store/apps/details?id=com.bcadigital.blu" 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 px-3 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-600/80 text-white text-xs font-semibold transition shadow-sm"
            >
              <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 0 1 0 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.802 8.99l-2.303 2.303-8.635-8.635z"/>
              </svg>
              <span>Play Store</span>
            </a>

            <!-- Apple App Store Button -->
            <a 
              href="https://apps.apple.com/id/app/blu-by-bca-digital/id1550237185" 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 px-3 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-600/80 text-white text-xs font-semibold transition shadow-sm"
            >
              <svg class="w-4 h-4 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.33c.64-.78 1.08-1.86.96-2.94-.93.04-2.06.62-2.72 1.4-.58.68-1.1 1.78-.96 2.84 1.04.08 2.08-.52 2.72-1.3z"/>
              </svg>
              <span>App Store</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Client-Side Logic -->
    <script>
      const waRadios = document.querySelectorAll<HTMLInputElement>('.wa-radio');
      const confirmRadios = document.querySelectorAll<HTMLInputElement>('.wa-confirm-radio');
      const bwdCheckboxes = document.querySelectorAll<HTMLInputElement>('.bwd-checkbox');
      const section2 = document.getElementById('section2JoinGroup');
      const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
      const form = document.getElementById('registrationForm') as HTMLFormElement;

      function updateFormFlow() {
        const selectedWa = document.querySelector<HTMLInputElement>('.wa-radio:checked')?.value;
        const selectedConfirm = document.querySelector<HTMLInputElement>('.wa-confirm-radio:checked')?.value;

        const hasCheckboxes = bwdCheckboxes.length > 0;
        const anyChecked = Array.from(bwdCheckboxes).some((cb) => cb.checked);

        if (hasCheckboxes && !anyChecked) {
          submitBtn.disabled = true;
          return;
        }

        if (selectedWa === 'sudah') {
          section2?.classList.add('hidden');
          submitBtn.disabled = false;
        } else if (selectedWa === 'belum') {
          section2?.classList.remove('hidden');
          submitBtn.disabled = selectedConfirm !== 'sudah';
        } else {
          submitBtn.disabled = true;
        }
      }

      waRadios.forEach((radio) => radio.addEventListener('change', updateFormFlow));
      confirmRadios.forEach((radio) => radio.addEventListener('change', updateFormFlow));
      bwdCheckboxes.forEach((cb) => cb.addEventListener('change', updateFormFlow));

      form?.addEventListener('submit', (e) => {
        if (bwdCheckboxes.length > 0) {
          const anyChecked = Array.from(bwdCheckboxes).some((cb) => cb.checked);
          if (!anyChecked) {
            e.preventDefault();
            alert('Silakan pilih minimal 1 aktivitas Blue Wave Day terlebih dahulu!');
          }
        }
      });

      updateFormFlow();
    </script>
  </body>
</html>