---
import { getSupabase } from '../lib/supabase';
import '../styles/global.css';

let message = '';
let isSuccess = false;

const locals = Astro.locals as any;
const runtimeEnv = locals?.runtime?.env || locals?.cloudflare?.env;
const supabase = getSupabase(runtimeEnv);

// ID Sesi Campaign Road to UI Half Marathon
const CAMPAIGN_SESSION_ID = '66666666-6666-4666-a666-666666666666';

let sessionDetails: { title: string; session_date: string } | null = null;

// Tangkap Submit Form Registrasi
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();

    const fullName = formData.get('full_name')?.toString()?.trim();
    const phoneNumber = formData.get('phone_number')?.toString()?.trim();
    const email = formData.get('email')?.toString()?.trim();
    const tier = 'bluewave';

    if (fullName && phoneNumber && email) {
      const { data, error } = await supabase.rpc('register_bluewave_session', {
        p_session_id: CAMPAIGN_SESSION_ID,
        p_full_name: fullName,
        p_phone_number: phoneNumber,
        p_tier: tier,
        p_email: email,
      });

      if (error) {
        message = `Gagal memproses pendaftaran: ${error.message}`;
      } else if (data && !data.success) {
        message = data.message;
      } else if (data && data.success) {
        message = data.message || 'Pendaftaran Road to UI Half Marathon Berhasil!';
        isSuccess = true;
      }
    } else {
      message = 'Harap isi semua kolom wajib!';
    }
  } catch (err: any) {
    message = `Terjadi kesalahan sistem: ${err.message}`;
  }
}

// Fetch Jadwal Sesi
try {
  const { data: sessionData } = await supabase
    .from('sessions')
    .select('title, session_date')
    .eq('id', CAMPAIGN_SESSION_ID)
    .single();

  if (sessionData) sessionDetails = sessionData;
} catch (e: any) {
  console.error('Fetch error:', e.message);
}
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registration - Road to UI Half Marathon | Blue Wave</title>
  </head>
  <body class="bg-slate-950 text-[#fff] min-h-screen flex items-center justify-center p-4 font-sans selection:bg-[#005BDF] selection:text-white">
    <div class="max-w-lg w-full bg-slate-900/95 backdrop-blur-md p-6 sm:p-8 rounded-2xl shadow-2xl border border-[#005BDF]/30">
      
      <!-- Brand & Event Header -->
      <div class="text-center mb-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold bg-[#005BDF]/15 text-blue-300 border border-[#005BDF]/30 mb-3">
          <span>Official Road to Campaign</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-[#fff] tracking-tight">
          ROAD TO <span class="text-[#005BDF]">UI HALF MARATHON</span>
        </h1>
        <p class="text-xs text-slate-400 mt-1 font-medium">Blue Wave Running Community</p>
        
        <!-- Info Jadwal Sesi -->
        {sessionDetails && (
          <div class="mt-4 p-3 bg-slate-800/80 border border-slate-700/80 rounded-xl text-center text-xs">
            <span class="text-slate-400">Jadwal Sesi Latihan: </span>
            <strong class="text-white font-semibold ml-1">{sessionDetails.session_date}</strong>
          </div>
        )}
      </div>

      <!-- Alert Notifikasi -->
      {message && (
        <div class={`p-4 rounded-xl mb-6 text-sm font-medium border ${
          isSuccess 
            ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' 
            : 'bg-rose-500/10 text-rose-400 border-rose-500/30'
        }`}>
          {message}
        </div>
      )}

      <!-- Form Submission -->
      <form method="POST" id="campaignForm" class="space-y-4">
        
        <!-- Nama Lengkap -->
        <div>
          <label for="full_name" class="block text-sm font-medium mb-1.5 text-slate-200">
            Nama Lengkap <span class="text-[#005BDF]">*</span>
          </label>
          <input 
            type="text" 
            id="full_name" 
            name="full_name" 
            required 
            placeholder="Sesuai kartu identitas"
            class="w-full px-4 py-2.5 bg-slate-800/90 border border-slate-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#005BDF] focus:border-[#005BDF] text-[#fff] placeholder-slate-500 text-sm transition"
          />
        </div>

        <!-- No WhatsApp -->
        <div>
          <label for="phone_number" class="block text-sm font-medium mb-1.5 text-slate-200">
            No. WhatsApp Aktif <span class="text-[#005BDF]">*</span>
          </label>
          <input 
            type="tel" 
            id="phone_number" 
            name="phone_number" 
            required 
            placeholder="0812xxxxxxxx"
            class="w-full px-4 py-2.5 bg-slate-800/90 border border-slate-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#005BDF] focus:border-[#005BDF] text-[#fff] placeholder-slate-500 text-sm transition"
          />
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-sm font-medium mb-1.5 text-slate-200">
            Alamat Email <span class="text-[#005BDF]">*</span>
          </label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            placeholder="nama@email.com"
            class="w-full px-4 py-2.5 bg-slate-800/90 border border-slate-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#005BDF] focus:border-[#005BDF] text-[#fff] placeholder-slate-500 text-sm transition"
          />
        </div>

        <!-- PERTANYAAN GROUP WHATSAPP -->
        <div class="pt-3 border-t border-slate-800">
          <label class="block text-xs font-semibold mb-2.5 text-slate-200">
            Sudah bergabung di grup WhatsApp Blue Wave? <span class="text-[#005BDF]">*</span>
          </label>
          <div class="flex items-center space-x-6">
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="radio" name="joined_wa" value="sudah" class="wa-radio w-4 h-4 text-[#005BDF] bg-slate-800 border-slate-700 focus:ring-[#005BDF]" required />
              <span class="text-xs font-medium text-slate-200">Sudah</span>
            </label>
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="radio" name="joined_wa" value="belum" class="wa-radio w-4 h-4 text-[#005BDF] bg-slate-800 border-slate-700 focus:ring-[#005BDF]" />
              <span class="text-xs font-medium text-slate-200">Belum</span>
            </label>
          </div>
        </div>

        <!-- SECTION POPUP JOIN WA GROUP -->
        <div id="section2JoinGroup" class="hidden p-4 bg-slate-800/90 border border-[#005BDF]/30 rounded-xl space-y-3 transition-all text-xs">
          <h3 class="font-bold text-[#005BDF]">Join Blue Wave WhatsApp Community</h3>
          <p class="text-slate-300 leading-relaxed text-[11px]">
            Gabung grup komunitas untuk informasi titik kumpul (meeting point), race brief, dan dokumentasi event:
          </p>
          <div>
            <a 
              href="https://chat.whatsapp.com/BAWU2LQlmqCAVZvYWPmHQE" 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-blue-400 hover:text-blue-300 underline font-medium break-all"
            >
              https://chat.whatsapp.com/BAWU2LQlmqCAVZvYWPmHQE
            </a>
          </div>

          <div class="pt-3 border-t border-slate-700">
            <label class="block font-semibold mb-2 text-slate-200">
              Konfirmasi: Apakah Anda Sudah Join? <span class="text-[#005BDF]">*</span>
            </label>
            <div class="flex items-center space-x-6">
              <label class="flex items-center space-x-2 cursor-pointer">
                <input type="radio" name="confirm_joined_wa" value="sudah" class="wa-confirm-radio w-4 h-4 text-[#005BDF] bg-slate-800 border-slate-700 focus:ring-[#005BDF]" />
                <span class="font-medium text-slate-200">Sudah</span>
              </label>
              <label class="flex items-center space-x-2 cursor-pointer">
                <input type="radio" name="confirm_joined_wa" value="belum" class="wa-confirm-radio w-4 h-4 text-[#005BDF] bg-slate-800 border-slate-700 focus:ring-[#005BDF]" />
                <span class="font-medium text-slate-200">Belum</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Tombol Submit -->
        <button 
          type="submit" 
          id="submitBtn"
          class="w-full py-3 px-4 bg-[#005BDF] hover:bg-[#004bb8] active:bg-[#003d96] transition duration-150 font-bold rounded-lg text-[#fff] shadow-lg shadow-[#005BDF]/25 mt-4 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
        >
          Daftar Road to UI Half Marathon
        </button>
      </form>

    </div>

    <script>
      const waRadios = document.querySelectorAll<HTMLInputElement>('.wa-radio');
      const confirmRadios = document.querySelectorAll<HTMLInputElement>('.wa-confirm-radio');
      const section2 = document.getElementById('section2JoinGroup');
      const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

      function updateFormFlow() {
        const selectedWa = document.querySelector<HTMLInputElement>('.wa-radio:checked')?.value;
        const selectedConfirm = document.querySelector<HTMLInputElement>('.wa-confirm-radio:checked')?.value;

        if (selectedWa === 'sudah') {
          section2?.classList.add('hidden');
          submitBtn.disabled = false;
        } else if (selectedWa === 'belum') {
          section2?.classList.remove('hidden');
          if (selectedConfirm === 'sudah') {
            submitBtn.disabled = false;
          } else {
            submitBtn.disabled = true;
          }
        }
      }

      waRadios.forEach((radio) => radio.addEventListener('change', updateFormFlow));
      confirmRadios.forEach((radio) => radio.addEventListener('change', updateFormFlow));

      updateFormFlow();
    </script>
  </body>
</html>